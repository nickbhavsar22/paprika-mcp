# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Paprika account (required) ---------------------------------------------
# Alternatively store these in ~/.paprika-mcp/config.json.
PAPRIKA_EMAIL=you@example.com
PAPRIKA_PASSWORD=your-paprika-password

# Optional: mimic the official Paprika app's User-Agent. If unset, the client
# tries to auto-detect it from an installed Paprika app.
# PAPRIKA_USER_AGENT=

# --- Hosted HTTP server (required only for server_http / Render) ------------
# Path token that guards the /mcp/<token> endpoint. On Render this is
# generated automatically; set it by hand for local HTTP testing.
# MCP_BEARER_TOKEN=
# Public base URL, used to build the photo upload link. Render injects
# RENDER_EXTERNAL_URL automatically; this is a manual override.
# PUBLIC_BASE_URL=

# --- Free thumbnail web-image search (optional) -----------------------------
# Enables the web-search tier of find_free_thumbnail. If either is missing,
# that tier is skipped and the rest of the thumbnail chain still works.
#
# KEY: a Google Cloud API key with the "Custom Search API" enabled at
#      https://console.cloud.google.com/apis/library/customsearch.googleapis.com
# CX:  a Search engine ID from
#      https://programmablesearchengine.google.com/controlpanel/create
#      Create it with "Search the entire web" AND "Image search" turned ON.
#
# Free tier is 100 queries/day; beyond that Google bills ~$5 per 1000.
# GOOGLE_IMAGE_SEARCH_KEY=
# GOOGLE_IMAGE_SEARCH_CX=
