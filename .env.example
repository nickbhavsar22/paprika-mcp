# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Paprika account (required) ---------------------------------------------
# Alternatively store these in ~/.paprika-mcp/config.json.
PAPRIKA_EMAIL=you@example.com
PAPRIKA_PASSWORD=your-paprika-password

# Optional: mimic the official Paprika app's User-Agent. If unset, the client
# tries to auto-detect it from an installed Paprika app.
# PAPRIKA_USER_AGENT=

# --- Hosted HTTP server (required only for server_http / Render) ------------
# Path token that guards the /mcp/<token> endpoint. On Render this is
# generated automatically; set it by hand for local HTTP testing.
# MCP_BEARER_TOKEN=
# Public base URL, used to build the photo upload link. Render injects
# RENDER_EXTERNAL_URL automatically; this is a manual override.
# PUBLIC_BASE_URL=

# --- Free thumbnail stock-photo search (optional) ---------------------------
# Enables the stock-photo tier of find_free_thumbnail. If unset, that tier is
# skipped and the rest of the thumbnail chain still works.
#
# Get a key instantly (free, no billing) at https://www.pexels.com/api/
# Free tier: 200 requests/hour, 20,000/month.
#
# Note: Google Programmable Search is NOT used here. Google closed the Custom
# Search JSON API to new customers, dropped whole-web search for new engines
# (Jan 20, 2026), and retires the API on Jan 1, 2027.
# PEXELS_API_KEY=
